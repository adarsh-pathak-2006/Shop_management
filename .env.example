# SECURITY WARNING: keep the secret key used in production secret!
SECRET_KEY=your-secret-key-here

# SECURITY WARNING: don't run with debug turned on in production!
DEBUG=False

# Your render domain
ALLOWED_HOSTS=your-app-name.onrender.com

# Redis cache URL (e.g., Upstash Redis, Redis Cloud)
# Format: redis://username:password@hostname:port/0
CACHE_URL=redis://127.0.0.1:6379/1

# Database URL (e.g., Neon DB Serverless Postgres)
# Format: postgres://user:password@hostname/dbname?sslmode=require
# DATABASE_URL=postgres://user:password@hostname/dbname?sslmode=require
